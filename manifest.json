{
  "manifest_version": 1,
  "name": "GaplessFix",
  "slug": "gapless-fix",
  "version": "1.0.0",
  "author": "GaplessFix contributors",
  "description": "网易云 Windows 无缝播放插件，让专辑里的两首歌连续衔接。",
  "betterncm_version": ">=1.3.4",
